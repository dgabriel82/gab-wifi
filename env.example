# Général
BASE_URL=https://gab-wifi.duckdns.org
PORT=3000
SECURE_COOKIES=true

# Google OpenID Connect
GOOGLE_CLIENT_ID=xxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx
GOOGLE_REDIRECT_URI=https://gab-wifi.duckdns.org/auth/google/callback

# UniFi
UNIFI_CONTROLLER_URL=https://192.168.1.1
UNIFI_SITE=default
UNIFI_USERNAME=bot_captive
UNIFI_PASSWORD=change_me
UNIFI_INSECURE_TLS=true

# Base de données
DATABASE_URL=postgresql://wifi:wifi@db:5432/wifi
RETENTION_DAYS=180
DEFAULT_MINUTES=480

# Admin
ADMIN_USER=admin
ADMIN_PASS=change_me
