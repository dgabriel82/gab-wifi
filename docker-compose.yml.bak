services:
  portal:
    build:
      context: ./portal
    container_name: wifi_portal
    environment:
      - PORT=3000
      - BASE_URL=https://gab-wifi.duckdns.org
      - COOKIE_SECRET=change-me-please

      - GOOGLE_CLIENT_ID=__A_REMPLIR__
      - GOOGLE_CLIENT_SECRET=__A_REMPLIR__
      - GOOGLE_REDIRECT_URI=https://gab-wifi.duckdns.org/auth/google/callback

      - DATABASE_URL=postgres://portal:portalpass@db:5432/portaldb
      - RETENTION_DAYS=180
      - CONSENT_VERSION=1.0
      - DEFAULT_MINUTES=480

      - UNIFI_CONTROLLER_URL=https://192.168.1.1
      - UNIFI_SITE=default
      - UNIFI_USERNAME=__A_REMPLIR__
      - UNIFI_PASSWORD=__A_REMPLIR__
    depends_on:
      - db
    restart: unless-stopped
    ports:
      - "80:3000"

  db:
    image: postgres:16-alpine
    container_name: wifi_db
    environment:
      - POSTGRES_DB=portaldb
      - POSTGRES_USER=portal
      - POSTGRES_PASSWORD=portalpass
    volumes:
      - ./pgdata:/var/lib/postgresql/data
    restart: unless-stopped
